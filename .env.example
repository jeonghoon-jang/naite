# 브라우저 (web, Vercel) — 공개돼도 되는 키만
VITE_SUPABASE_URL=                 # https://<project-ref>.supabase.co (대시보드 주소 아님)
VITE_SUPABASE_ANON_KEY=            # anon 또는 publishable key
VITE_KAKAO_JS_KEY=

# 서버 (web/api, Vercel 환경변수)
SUPABASE_URL=                      # VITE_SUPABASE_URL과 같은 값
SUPABASE_SERVICE_ROLE_KEY=         # service_role 또는 secret key (파이프라인 전용, 브라우저·커밋 금지)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
KAKAO_REST_KEY=
SIM_THRESHOLD=0.25

# 파이프라인 (로컬 전용, 루트 .env)
TOUR_KEY=
